SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=postgres://flowpro_user:change-me@localhost:5432/flowpro_db

# Production security. Keep these false for plain local HTTP.
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PORT=False
SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
CSRF_COOKIE_HTTPONLY=False
X_FRAME_OPTIONS=DENY
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

DEFAULT_FROM_EMAIL=website@example.com
SERVER_EMAIL=website@example.com
ADMIN_NOTIFICATION_EMAIL=owner@example.com

EMAIL_PROVIDER=console
# Options: console, sender_net, google_workspace, google_workspace_relay, custom_smtp
# Fill EMAIL_HOST_USER and EMAIL_HOST_PASSWORD with the selected provider credentials.
# Explicit EMAIL_BACKEND/EMAIL_HOST/EMAIL_PORT values override provider defaults.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20

# Sender.net SMTP:
# EMAIL_PROVIDER=sender_net
# DEFAULT_FROM_EMAIL=bookings@yourdomain.com
# EMAIL_HOST_USER=your_sender_smtp_username
# EMAIL_HOST_PASSWORD=your_sender_smtp_password_or_key

# Google Workspace SMTP with an app password:
# EMAIL_PROVIDER=google_workspace
# DEFAULT_FROM_EMAIL=bookings@yourdomain.com
# EMAIL_HOST_USER=bookings@yourdomain.com
# EMAIL_HOST_PASSWORD=your_google_workspace_app_password

# Google Workspace SMTP relay:
# EMAIL_PROVIDER=google_workspace_relay
# DEFAULT_FROM_EMAIL=bookings@yourdomain.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

PIXABAY_API_KEY=

# --- Trade configuration ---
# Comma-separated service choices for booking and invoice forms.
# Each trade uses its own list.  Default (below) is for plumbing.
SERVICE_CHOICES=Leaking Pipe,Blocked Drain,Water Heater,Toilet Repair,Burst Pipe,Bathroom/Kitchen,Gas Plumbing,General Maintenance,Other

# Set to UK to enforce UK phone and postcode validation.
# Leave blank or set any other value for international mode.
COUNTRY=UK
