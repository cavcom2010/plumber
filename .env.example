# ── Django core ──
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=postgres://flowpro_user:change-me@localhost:5432/flowpro_db

# ── Production security ──
# Keep these false for plain local HTTP. Set to True for HTTPS in production.
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PORT=False
SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
CSRF_COOKIE_HTTPONLY=False
X_FRAME_OPTIONS=DENY
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# ── Email ──
EMAIL_PROVIDER=console
# Options: console, sender_net, google_workspace, google_workspace_relay, custom_smtp
#
# sender_net:
#   EMAIL_PROVIDER=sender_net
#   DEFAULT_FROM_EMAIL=bookings@yourdomain.com
#   EMAIL_HOST_USER=your_sender_smtp_username
#   EMAIL_HOST_PASSWORD=your_sender_smtp_password_or_key
#
# Google Workspace (app password):
#   EMAIL_PROVIDER=google_workspace
#   DEFAULT_FROM_EMAIL=bookings@yourdomain.com
#   EMAIL_HOST_USER=bookings@yourdomain.com
#   EMAIL_HOST_PASSWORD=your_app_password
#
# Google Workspace relay:
#   EMAIL_PROVIDER=google_workspace_relay
#   DEFAULT_FROM_EMAIL=bookings@yourdomain.com
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
#
# Custom SMTP (overrides EMAIL_HOST/EMAIL_PORT/EMAIL_BACKEND):
#   EMAIL_PROVIDER=custom_smtp
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587

DEFAULT_FROM_EMAIL=website@example.com
SERVER_EMAIL=website@example.com
ADMIN_NOTIFICATION_EMAIL=owner@example.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20

# ── Error email alerts (500 errors when DEBUG=False) ──
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com

# ── Rate limiting (booking form) ──
# Format: count/period. s=seconds, m=minutes, h=hours, d=days.
# Leave blank to disable.
BOOKING_RATE_LIMIT=5/m

# ── Logging ──
LOG_LEVEL=INFO

# ── Trade configuration ──
# Comma-separated service choices for booking and invoice forms.
# Customise per trade, e.g. Kitchen Fitting,Decking,Flooring
SERVICE_CHOICES=Leaking Pipe,Blocked Drain,Water Heater,Toilet Repair,Burst Pipe,Bathroom/Kitchen,Gas Plumbing,General Maintenance,Other

# Set to UK to enforce UK phone and postcode validation.
# Leave blank or set any other value for international mode.
COUNTRY=UK

# ── Optional: media images for service detail pages ──
# Used by the prefill_service_details management command.
# Get a key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── Twilio WhatsApp integration ──
# Required to send WhatsApp notifications to the business owner when a
# booking enquiry is submitted.  Sign up at https://www.twilio.com/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
